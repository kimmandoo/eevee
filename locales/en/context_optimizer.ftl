context-optimizer-source-hint = o ranked excerpts · l evidence ledger · c exact request comparison
context-optimizer-summary = { $kind } · { $tokens } / { $budget } local tokens · baseline { $baseline }
context-optimizer-contributions = Local contribution: packet { $packet } + mandatory notes { $notes }; not the entire provider prompt.
context-optimizer-measurements = { $bytes } B · { $micros } µs processing · { $hits } local revision/token-cache hits
context-optimizer-tokenizer = Tokenizer: { $tokenizer }. Local Unicode boundaries, not provider usage, retention or a billing discount.
context-optimizer-overflow = REFUSED: mandatory instructions, pins or notes exceed budget. Increase budget explicitly or cancel. This preview cannot dispatch.
context-optimizer-apply-notice = Apply stages this exact packet for the next ordinary request; it starts no request, command or approval. Cancel keeps the previous selection and draft unchanged.
context-optimizer-pin = Mandatory pin
context-optimizer-included = Ranked excerpt
context-optimizer-omitted = Omitted
context-optimizer-applied = Applied to the next ordinary request; no request started.
context-optimizer-unapplied = Preview only; no outgoing change.
context-optimizer-prior-applied = Preview not applied; previous packet still active.
context-optimizer-overflow-previous = REFUSED preview; previous packet stays applied.
context-optimizer-overflow-unapplied = REFUSED preview; nothing newly applied.
context-optimizer-overflow-hint = Apply blocked · o budget · n cancel · PgUp/Dn
