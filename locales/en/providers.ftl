providers-setup-codex = { "Update the same Codex installation shown under Executable, not a second copy elsewhere on PATH. Homebrew: brew upgrade --cask codex. npm: npm install -g @openai/codex@latest. Then Refresh installed providers, check the observed path/version, and refresh /model. Eevee never upgrades it automatically." }

providers-setup-claude = { "Claude Agent SDK uses Anthropic API credentials: ANTHROPIC_API_KEY, an Anthropic Console OAuth profile (Connect runs the official ant CLI 1.40.0 from PATH), or configured Bedrock/Vertex cloud credentials. Install the pinned SDK sidecar described in Setup (README). Claude CLI login is not SDK setup: claude.ai subscription OAuth tokens cannot be reused here. Eevee never collects tokens. A model request still needs separate Run approval." }

providers-setup-opencode = { "Install/update latest stable OpenCode on PATH: npm install -g opencode-ai@latest. Then Refresh installed providers; ACP capabilities are negotiated before use." }

providers-setup-gemini = { "Install/update latest stable Gemini on PATH: npm install -g @google/gemini-cli@latest. Then Refresh installed providers; current Gemini uses --acp." }

providers-setup-devin = { "Install latest stable Devin from https://docs.devin.ai/cli/; update an existing installation with devin update. Then Refresh installed providers. Eevee does not run an installer automatically." }

providers-setup-chatgpt = { "Choose Browser or Device login directly; no installed CLI is needed. This selects the official ChatGPT account route and its plan, not metered OpenAI API billing. Review account replacement, session-only or private local plaintext storage, and model-metadata-only continuation before login. Saved credentials are not encrypted or stored in a keychain. Reconnect when the access grant expires; Eevee does not auto-renew it or modify a provider credential store. Advanced settings retain manual access token/account entry and explicit CLI-token import. Native Implement proposes new/existing workspace paths and creates or replaces only after exact one-shot permission; /paths optionally restricts targets. Plan/Review remain read-only. Configuration and metadata access do not prove model eligibility." }

providers-setup-openai = { "Enter an OpenAI API key here, or use OPENAI_API_KEY; optional OPENAI_BASE_URL and OPENAI_MODEL. This is metered API access, not ChatGPT subscription authentication. Setup offers session-only storage by default, or explicitly saved private local plaintext (not encrypted or an OS keychain). Configuration and metadata access do not prove inference, account access or billing." }

providers-setup-anthropic = { "Enter an Anthropic API key here, or use ANTHROPIC_API_KEY; optional ANTHROPIC_BASE_URL and ANTHROPIC_MODEL. Claude subscription/session OAuth is not API authentication and is rejected. Setup offers session-only storage by default, or explicitly saved private local plaintext (not encrypted or an OS keychain). Configuration and metadata access do not prove inference, account access or billing." }

providers-setup-google = { "Enter a Gemini API key here, or use GEMINI_API_KEY (or GOOGLE_API_KEY); optional GEMINI_BASE_URL and GEMINI_MODEL. This is API access, not a host CLI subscription/login. Setup offers session-only storage by default, or explicitly saved private local plaintext (not encrypted or an OS keychain). Configuration and metadata access do not prove inference, account access or billing." }

providers-setup-compatible = { "Enter an endpoint, optional model and API key here, or explicitly choose keyless for a trusted endpoint. Compatible supports chat_completions or responses. HTTPS is required except HTTP loopback. Endpoint trust, account access and billing remain yours. Setup offers session-only storage by default, or explicitly saved private local plaintext (not encrypted or an OS keychain). Configuration and metadata access do not prove inference, account access or billing." }

providers-setup-none = { "Select a supported provider before installation or connection setup." }

